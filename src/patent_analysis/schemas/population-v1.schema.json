{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:population:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "filters",
    "family_mode"
  ],
  "properties": {
    "filters": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "match",
              "value"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "match": {
                "const": "exact"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "exclude": {
                "type": "boolean",
                "default": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "match",
              "values"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "match": {
                "const": "one_of"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "type": "boolean",
                "default": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "match",
              "start",
              "end"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "match": {
                "const": "year_range"
              },
              "start": {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2199
              },
              "end": {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2199
              },
              "exclude": {
                "type": "boolean",
                "default": false
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "match",
              "values"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "match": {
                "const": "selection"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1000,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "type": "boolean",
                "default": false
              },
              "date_role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "start": {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2199
              },
              "end": {
                "type": "integer",
                "minimum": 1800,
                "maximum": 2199
              }
            },
            "dependentRequired": {
              "date_role": [
                "start",
                "end"
              ],
              "start": [
                "date_role",
                "end"
              ],
              "end": [
                "date_role",
                "start"
              ]
            }
          }
        ]
      }
    },
    "family_mode": {
      "enum": [
        "records",
        "earliest"
      ]
    },
    "family_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "date_role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "family_mode": {
            "const": "earliest"
          }
        }
      },
      "then": {
        "required": [
          "family_role"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "family_role"
              ]
            },
            {
              "required": [
                "date_role"
              ]
            }
          ]
        }
      }
    }
  ]
}
