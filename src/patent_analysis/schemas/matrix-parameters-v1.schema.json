{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:matrix-parameters:1.0.0",
  "title": "matrix.v1 AnalysisSpec",
  "type": "object",
  "required": [
    "analysis_contract_version",
    "analysis_id",
    "resolution",
    "normalization",
    "population",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_contract_version": {
      "const": "2.0.0"
    },
    "analysis_id": {
      "const": "matrix.v1"
    },
    "resolution": {
      "type": "object"
    },
    "normalization": {
      "type": "object",
      "required": [
        "profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "population": {
      "$ref": "#/$defs/population"
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "required": [
        "x_role",
        "y_role"
      ],
      "additionalProperties": false,
      "properties": {
        "x_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "y_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "x_classification_level": {
          "enum": [
            "full",
            "class",
            "subclass",
            "main_group",
            "subgroup"
          ]
        },
        "y_classification_level": {
          "enum": [
            "full",
            "class",
            "subclass",
            "main_group",
            "subgroup"
          ]
        },
        "x_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "y_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "include_axis_other": {
          "type": "boolean",
          "default": true
        },
        "measure": {
          "const": "count",
          "default": "count"
        },
        "pie_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "pie_classification_level": {
          "enum": [
            "full",
            "class",
            "subclass",
            "main_group",
            "subgroup"
          ]
        },
        "pie_limit": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8,
          "default": 5
        }
      },
      "dependentRequired": {
        "pie_classification_level": [
          "pie_role"
        ],
        "pie_limit": [
          "pie_role"
        ]
      }
    },
    "population": {
      "type": "object",
      "required": [
        "filters",
        "selection_sets",
        "family_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "filters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/exactFilter"
              },
              {
                "$ref": "#/$defs/oneOfFilter"
              },
              {
                "$ref": "#/$defs/yearRangeFilter"
              },
              {
                "$ref": "#/$defs/yearFilter"
              },
              {
                "$ref": "#/$defs/outsideYearRangeFilter"
              }
            ]
          }
        },
        "selection_sets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/selectionSet"
          }
        },
        "family_mode": {
          "enum": [
            "records",
            "earliest"
          ]
        },
        "family_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "date_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family_mode": {
                "const": "earliest"
              }
            }
          },
          "then": {
            "required": [
              "family_role"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "family_role"
                  ]
                },
                {
                  "required": [
                    "date_role"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "exactFilter": {
      "type": "object",
      "required": [
        "role",
        "effect",
        "match",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "match": {
          "const": "exact"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oneOfFilter": {
      "type": "object",
      "required": [
        "role",
        "effect",
        "match",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "match": {
          "const": "one_of"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "yearRangeFilter": {
      "type": "object",
      "required": [
        "role",
        "effect",
        "match",
        "start_year",
        "end_year"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "match": {
          "const": "year_range"
        },
        "start_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2199
        },
        "end_year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2199
        }
      }
    },
    "yearFilter": {
      "type": "object",
      "required": [
        "role",
        "effect",
        "match",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "match": {
          "const": "year"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "outsideYearRangeFilter": {
      "type": "object",
      "required": [
        "role",
        "effect",
        "match",
        "start_year",
        "end_year"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "match": {
          "const": "outside_year_range"
        },
        "start_year": {
          "type": "integer"
        },
        "end_year": {
          "type": "integer"
        }
      }
    },
    "selectionSet": {
      "type": "object",
      "required": [
        "dimension_role",
        "mode",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "dimension_role": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "include",
            "exclude"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_date_role": {
          "type": "string",
          "minLength": 1
        },
        "start_year": {
          "type": "integer"
        },
        "end_year": {
          "type": "integer"
        }
      },
      "dependentRequired": {
        "source_date_role": [
          "start_year",
          "end_year"
        ],
        "start_year": [
          "source_date_role",
          "end_year"
        ],
        "end_year": [
          "source_date_role",
          "start_year"
        ]
      }
    }
  }
}
