{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:points-render-spec:1.0.0",
  "title": "Points RenderSpec 1.0.0",
  "type": "object",
  "required": [
    "render_spec_contract_version",
    "renderer_kind",
    "locale",
    "timezone",
    "width",
    "height",
    "font_family",
    "animation",
    "axis_label_max_graphemes",
    "echarts_version",
    "render_profile_id"
  ],
  "additionalProperties": false,
  "properties": {
    "render_spec_contract_version": {"const": "1.0.0"},
    "renderer_kind": {"const": "points.bubble.svg"},
    "locale": {"const": "ja-JP"},
    "palette": {"enum": ["standard", "colorblind", "monochrome", "high-contrast"]},
    "timezone": {"const": "UTC"},
    "width": {"const": 1200},
    "height": {"const": 675},
    "font_family": {"const": "Yu Gothic UI, Yu Gothic, Meiryo, sans-serif"},
    "animation": {"const": false},
    "axis_label_max_graphemes": {"const": 28},
    "echarts_version": {"const": "6.1.0"},
    "render_profile_id": {"const": "points-svg-ja-jp-node24-echarts6.v1"}
  }
}
