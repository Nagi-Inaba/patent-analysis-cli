{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:inventor-cluster-flow-result:1.0.0",
  "title": "inventor-cluster-flow result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "algorithm_version",
    "statistics",
    "input_coverage",
    "family_basis",
    "provenance",
    "identity_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "const": "inventor-cluster-flow.v1"
    },
    "algorithm_version": {
      "const": "1.0.0"
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unplottable",
        "nodes",
        "links",
        "calendar",
        "missing_date_record_ids",
        "basis",
        "coverage"
      ],
      "properties": {
        "unplottable": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "person_key",
              "person_token",
              "inventor_id",
              "display_name",
              "identity_status",
              "caveats",
              "candidate_ids",
              "source_ids",
              "reasons"
            ],
            "properties": {
              "person_key": {
                "type": "array",
                "prefixItems": [
                  {
                    "enum": [
                      "id",
                      "name",
                      "ambiguous_id",
                      "ambiguous_name"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "person_token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "inventor_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "identity_status": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "provided_id",
                    "curated_mapping",
                    "normalized_name_only",
                    "ambiguous"
                  ]
                },
                "uniqueItems": true
              },
              "caveats": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "candidate_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "source_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "reasons": {
                "type": "array",
                "maxItems": 2,
                "items": {
                  "enum": [
                    "ambiguous_identity",
                    "missing_date"
                  ]
                }
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "maxItems": 18000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "year",
              "kind",
              "members",
              "size",
              "split",
              "merge"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "kind": {
                "enum": [
                  "cluster",
                  "not_observed",
                  "newly_observed",
                  "scope_entry",
                  "scope_exit"
                ]
              },
              "members": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "split": {
                "type": "boolean"
              },
              "merge": {
                "type": "boolean"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 50000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "source_year",
              "target_year",
              "members",
              "width",
              "kind"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "source_year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "target_year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "members": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              },
              "width": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "kind": {
                "enum": [
                  "shared_members",
                  "not_observed",
                  "newly_observed",
                  "scope_entry",
                  "scope_exit"
                ]
              }
            }
          }
        },
        "calendar": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "year",
              "observed"
            ],
            "properties": {
              "year": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "observed": {
                "type": "boolean"
              }
            }
          }
        },
        "missing_date_record_ids": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "community_method",
            "pair_weight",
            "graph_scope",
            "links",
            "width",
            "boundary"
          ],
          "properties": {
            "community_method": {
              "enum": [
                "connected_components",
                "greedy_modularity"
              ]
            },
            "pair_weight": {
              "enum": [
                "joint_unit_count",
                "unit_pair_fractional"
              ]
            },
            "graph_scope": {
              "const": "full_year_local_units"
            },
            "links": {
              "const": "adjacent_calendar_years_only"
            },
            "width": {
              "const": "observed_person_memberships"
            },
            "boundary": {
              "const": "scope_entry_exit_not_activity_claim"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records",
            "missing_date_records",
            "ambiguous_people"
          ],
          "properties": {
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "missing_date_records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ambiguous_people": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "input_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_rows",
        "included_rows",
        "filtered_rows",
        "missing_inventors",
        "missing_date",
        "missing_applicants",
        "missing_classification"
      ],
      "properties": {
        "input_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "included_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filtered_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_inventors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_date": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_applicants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_classification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "family_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_mode",
        "unit"
      ],
      "properties": {
        "family_mode": {
          "const": "records"
        },
        "unit": {
          "enum": [
            "records",
            "publication",
            "application",
            "family"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patent_sha256",
        "sidecar_state",
        "sidecars"
      ],
      "properties": {
        "patent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sidecar_state": {
          "enum": [
            "provided",
            "input_not_provided"
          ]
        },
        "sidecars": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "format",
              "schema_version",
              "byte_size",
              "sha256"
            ],
            "properties": {
              "table": {
                "enum": [
                  "bundle",
                  "sources",
                  "identities",
                  "entities",
                  "entity_aliases",
                  "groups",
                  "events",
                  "personal_evidence",
                  "reviews",
                  "citations"
                ]
              },
              "format": {
                "enum": [
                  "json",
                  "csv"
                ]
              },
              "schema_version": {
                "const": "1.0.0"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "identity_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_key",
          "person_token",
          "inventor_id",
          "display_name",
          "identity_status",
          "caveats",
          "candidate_ids",
          "source_ids"
        ],
        "properties": {
          "person_key": {
            "type": "array",
            "prefixItems": [
              {
                "enum": [
                  "id",
                  "name",
                  "ambiguous_id",
                  "ambiguous_name"
                ]
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "person_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "inventor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "identity_status": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "enum": [
                "provided_id",
                "curated_mapping",
                "normalized_name_only",
                "ambiguous"
              ]
            },
            "uniqueItems": true
          },
          "caveats": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "uniqueItems": true
          },
          "candidate_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          },
          "source_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          }
        }
      }
    }
  },
  "$defs": {
    "identityEvidenceIds": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    }
  }
}
