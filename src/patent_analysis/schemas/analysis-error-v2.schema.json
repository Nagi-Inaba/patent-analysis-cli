{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:analysis-error:2.0.0",
  "title": "AnalysisErrorV2",
  "type": "object",
  "required": ["analysis_contract_version", "ok", "error"],
  "additionalProperties": false,
  "properties": {
    "analysis_contract_version": {"const": "2.0.0"},
    "ok": {"const": false},
    "error": {
      "type": "object",
      "required": ["code", "message", "details"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      }
    }
  }
}
