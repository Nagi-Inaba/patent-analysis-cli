{
  "$id": "urn:patent-analysis:matrix-render-spec:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "animation": {
      "const": false
    },
    "axis_label_max_graphemes": {
      "const": 28
    },
    "echarts_version": {
      "const": "6.1.0"
    },
    "font_family": {
      "const": "Yu Gothic UI, Yu Gothic, Meiryo, sans-serif"
    },
    "height": {
      "const": 675
    },
    "locale": {
      "const": "ja-JP"
    },
    "palette": {
      "enum": [
        "standard",
        "colorblind",
        "monochrome",
        "high-contrast"
      ]
    },
    "render_profile_id": {
      "const": "matrix-svg-ja-jp-node22-echarts6.v1"
    },
    "render_spec_contract_version": {
      "const": "1.0.0"
    },
    "renderer_kind": {
      "enum": [
        "matrix.bubble.svg",
        "matrix.heatmap.svg"
      ]
    },
    "timezone": {
      "const": "UTC"
    },
    "value_labels": {
      "enum": [
        "hidden",
        "shown"
      ]
    },
    "width": {
      "const": 1200
    }
  },
  "required": [
    "render_spec_contract_version",
    "renderer_kind",
    "locale",
    "timezone",
    "width",
    "height",
    "font_family",
    "animation",
    "axis_label_max_graphemes",
    "echarts_version",
    "render_profile_id"
  ],
  "type": "object"
}
