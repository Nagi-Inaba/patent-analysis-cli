{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:chart-model-build-receipt:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chart_model_build_receipt_version",
    "analysis_result_sha256",
    "label_overlay_sha256",
    "chart_model_sha256",
    "chart_model_bytes",
    "row_count",
    "builder_id",
    "builder_version"
  ],
  "properties": {
    "chart_model_build_receipt_version": {"const": "1.0.0"},
    "analysis_result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label_overlay_sha256": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "null"}
      ]
    },
    "chart_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chart_model_bytes": {
      "type": "string",
      "maxLength": 2796204,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "row_count": {"type": "integer", "minimum": 0, "maximum": 101},
    "builder_id": {"const": "patent-analysis.ranking-chart-model-builder"},
    "builder_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
