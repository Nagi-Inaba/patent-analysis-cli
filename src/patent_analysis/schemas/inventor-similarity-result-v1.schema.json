{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:inventor-similarity-result:1.0.0",
  "title": "inventor-similarity result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "algorithm_version",
    "statistics",
    "input_coverage",
    "family_basis",
    "provenance",
    "identity_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "const": "inventor-similarity.v1"
    },
    "algorithm_version": {
      "const": "1.0.0"
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "profiles",
        "classifications",
        "similarities",
        "co_inventor_edges",
        "basis",
        "coverage"
      ],
      "properties": {
        "features": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "person_key",
              "person_token",
              "inventor_id",
              "display_name",
              "identity_status",
              "caveats",
              "candidate_ids",
              "source_ids",
              "values",
              "undefined_reason"
            ],
            "properties": {
              "person_key": {
                "type": "array",
                "prefixItems": [
                  {
                    "enum": [
                      "id",
                      "name",
                      "ambiguous_id",
                      "ambiguous_name"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "person_token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "inventor_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "identity_status": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "provided_id",
                    "curated_mapping",
                    "normalized_name_only",
                    "ambiguous"
                  ]
                },
                "uniqueItems": true
              },
              "caveats": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "candidate_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "source_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "values": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "undefined_reason": {
                "anyOf": [
                  {
                    "enum": [
                      "ambiguous_identity",
                      "zero_vector"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "profiles": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "classifications": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "enum": [
                  "IPC",
                  "CPC"
                ]
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "similarities": {
          "type": "array",
          "maxItems": 20100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "cosine",
              "undefined_reason",
              "shared_classifications"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "cosine": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "undefined_reason": {
                "anyOf": [
                  {
                    "enum": [
                      "undefined_profile"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "shared_classifications": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "enum": [
                        "IPC",
                        "CPC"
                      ]
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "co_inventor_edges": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "weight"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "weight": {
                "$ref": "#/$defs/exact"
              }
            }
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature",
            "person_weight",
            "classification_weight",
            "precision",
            "distance",
            "pair_storage",
            "tfidf"
          ],
          "properties": {
            "feature": {
              "enum": [
                "composition",
                "count",
                "tfidf"
              ]
            },
            "person_weight": {
              "enum": [
                "full",
                "fractional"
              ]
            },
            "classification_weight": {
              "enum": [
                "full",
                "fractional"
              ]
            },
            "precision": {
              "const": 12
            },
            "distance": {
              "const": "unit_vector_chord"
            },
            "pair_storage": {
              "const": "upper_triangle_with_diagonal"
            },
            "tfidf": {
              "const": "count_times_1_plus_ln_smoothed_eligible_document_frequency"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "people",
            "undefined_profiles"
          ],
          "properties": {
            "people": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "undefined_profiles": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      }
    },
    "input_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_rows",
        "included_rows",
        "filtered_rows",
        "missing_inventors",
        "missing_date",
        "missing_applicants",
        "missing_classification"
      ],
      "properties": {
        "input_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "included_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filtered_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_inventors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_date": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_applicants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_classification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "family_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_mode",
        "unit"
      ],
      "properties": {
        "family_mode": {
          "const": "records"
        },
        "unit": {
          "enum": [
            "records",
            "publication",
            "application",
            "family"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patent_sha256",
        "sidecar_state",
        "sidecars"
      ],
      "properties": {
        "patent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sidecar_state": {
          "enum": [
            "provided",
            "input_not_provided"
          ]
        },
        "sidecars": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "format",
              "schema_version",
              "byte_size",
              "sha256"
            ],
            "properties": {
              "table": {
                "enum": [
                  "bundle",
                  "sources",
                  "identities",
                  "entities",
                  "entity_aliases",
                  "groups",
                  "events",
                  "personal_evidence",
                  "reviews",
                  "citations"
                ]
              },
              "format": {
                "enum": [
                  "json",
                  "csv"
                ]
              },
              "schema_version": {
                "const": "1.0.0"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "identity_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_key",
          "person_token",
          "inventor_id",
          "display_name",
          "identity_status",
          "caveats",
          "candidate_ids",
          "source_ids"
        ],
        "properties": {
          "person_key": {
            "type": "array",
            "prefixItems": [
              {
                "enum": [
                  "id",
                  "name",
                  "ambiguous_id",
                  "ambiguous_name"
                ]
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "person_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "inventor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "identity_status": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "enum": [
                "provided_id",
                "curated_mapping",
                "normalized_name_only",
                "ambiguous"
              ]
            },
            "uniqueItems": true
          },
          "caveats": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "uniqueItems": true
          },
          "candidate_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          },
          "source_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          }
        }
      }
    }
  },
  "$defs": {
    "identityEvidenceIds": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "numerator",
        "denominator"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.402823669209385e+38
        },
        "numerator": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 40
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 40
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_key",
        "person_token",
        "inventor_id",
        "display_name",
        "identity_status",
        "caveats",
        "candidate_ids",
        "source_ids",
        "eligible",
        "activity",
        "classification_total",
        "entropy",
        "hhi",
        "predominant_classification",
        "undefined_reason"
      ],
      "properties": {
        "person_key": {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "id",
                "name",
                "ambiguous_id",
                "ambiguous_name"
              ]
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "person_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "inventor_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "identity_status": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "enum": [
              "provided_id",
              "curated_mapping",
              "normalized_name_only",
              "ambiguous"
            ]
          },
          "uniqueItems": true
        },
        "caveats": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "uniqueItems": true
        },
        "candidate_ids": {
          "$ref": "#/$defs/identityEvidenceIds"
        },
        "source_ids": {
          "$ref": "#/$defs/identityEvidenceIds"
        },
        "eligible": {
          "type": "boolean"
        },
        "activity": {
          "$ref": "#/$defs/exact"
        },
        "classification_total": {
          "$ref": "#/$defs/exact"
        },
        "entropy": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "hhi": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "predominant_classification": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "enum": [
                    "IPC",
                    "CPC"
                  ]
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "null"
            }
          ]
        },
        "undefined_reason": {
          "anyOf": [
            {
              "enum": [
                "missing_classification"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
