{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:timeline-result:1.0.0",
  "title": "timeline.v1 data",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "algorithm_version",
    "measure",
    "x",
    "series",
    "population",
    "contributions",
    "limits"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_id": {"const": "timeline.v1"},
    "algorithm_version": {"const": "1.0.0"},
    "measure": {"$ref": "#/$defs/measure"},
    "x": {
      "type": "array",
      "maxItems": 400,
      "items": {"type": "string", "pattern": "^(?:18|19|20|21)[0-9]{2}$"}
    },
    "series": {
      "type": "array",
      "maxItems": 101,
      "items": {"$ref": "#/$defs/seriesItem"}
    },
    "population": {"$ref": "#/$defs/population"},
    "contributions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "limits": {
      "type": "object",
      "required": ["max_top_n", "max_expanded_contributions"],
      "additionalProperties": false,
      "properties": {
        "max_top_n": {"const": 100},
        "max_expanded_contributions": {"const": 1000000}
      }
    }
  },
  "$defs": {
    "measure": {
      "type": "object",
      "required": ["mode", "role"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["count", "sum", "average", "max", "min"]},
        "role": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "count"}}},
          "then": {"properties": {"role": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["sum", "average", "max", "min"]}}},
          "then": {"properties": {"role": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "seriesItem": {
      "type": "object",
      "required": ["label", "values", "row_counts", "is_other"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "values": {
          "type": "array",
          "maxItems": 400,
          "items": {"type": "number"}
        },
        "row_counts": {
          "type": "array",
          "maxItems": 400,
          "items": {"type": "integer", "minimum": 0}
        },
        "is_other": {"type": "boolean"}
      }
    },
    "population": {
      "type": "object",
      "required": [
        "input_rows",
        "visible_rows",
        "invalid_year_rows",
        "outside_year_range_rows",
        "blank_series_rows",
        "excluded_rows"
      ],
      "additionalProperties": false,
      "properties": {
        "input_rows": {"type": "integer", "minimum": 0},
        "visible_rows": {"type": "integer", "minimum": 0},
        "invalid_year_rows": {"type": "integer", "minimum": 0},
        "outside_year_range_rows": {"type": "integer", "minimum": 0},
        "blank_series_rows": {"type": "integer", "minimum": 0},
        "excluded_rows": {"type": "integer", "minimum": 0}
      }
    }
  }
}
