{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:inventor-network-result:1.0.0",
  "title": "inventor-network result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "algorithm_version",
    "statistics",
    "input_coverage",
    "family_basis",
    "provenance",
    "identity_evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analysis_id": {
      "const": "inventor-network.v1"
    },
    "algorithm_version": {
      "const": "1.0.0"
    },
    "statistics": {
      "$ref": "#/$defs/graph"
    },
    "input_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_rows",
        "included_rows",
        "filtered_rows",
        "missing_inventors",
        "missing_date",
        "missing_applicants",
        "missing_classification"
      ],
      "properties": {
        "input_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "included_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "filtered_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_inventors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_date": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_applicants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing_classification": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "family_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_mode",
        "unit"
      ],
      "properties": {
        "family_mode": {
          "const": "records"
        },
        "unit": {
          "enum": [
            "records",
            "publication",
            "application",
            "family"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patent_sha256",
        "sidecar_state",
        "sidecars"
      ],
      "properties": {
        "patent_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sidecar_state": {
          "enum": [
            "provided",
            "input_not_provided"
          ]
        },
        "sidecars": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "table",
              "format",
              "schema_version",
              "byte_size",
              "sha256"
            ],
            "properties": {
              "table": {
                "enum": [
                  "bundle",
                  "sources",
                  "identities",
                  "entities",
                  "entity_aliases",
                  "groups",
                  "events",
                  "personal_evidence",
                  "reviews",
                  "citations"
                ]
              },
              "format": {
                "enum": [
                  "json",
                  "csv"
                ]
              },
              "schema_version": {
                "const": "1.0.0"
              },
              "byte_size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "identity_evidence": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "person_key",
          "person_token",
          "inventor_id",
          "display_name",
          "identity_status",
          "caveats",
          "candidate_ids",
          "source_ids"
        ],
        "properties": {
          "person_key": {
            "type": "array",
            "prefixItems": [
              {
                "enum": [
                  "id",
                  "name",
                  "ambiguous_id",
                  "ambiguous_name"
                ]
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "person_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "inventor_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              {
                "type": "null"
              }
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "identity_status": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "enum": [
                "provided_id",
                "curated_mapping",
                "normalized_name_only",
                "ambiguous"
              ]
            },
            "uniqueItems": true
          },
          "caveats": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "uniqueItems": true
          },
          "candidate_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          },
          "source_ids": {
            "$ref": "#/$defs/identityEvidenceIds"
          }
        }
      }
    }
  },
  "$defs": {
    "identityEvidenceIds": {
      "type": "array",
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16384
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges",
        "unplottable",
        "communities",
        "coverage",
        "basis",
        "pagerank_convergence"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "person_key",
              "person_token",
              "inventor_id",
              "display_name",
              "identity_status",
              "caveats",
              "activity",
              "degree",
              "candidate_ids",
              "source_ids",
              "strength",
              "betweenness_unweighted",
              "betweenness_weighted",
              "pagerank",
              "community_id"
            ],
            "properties": {
              "person_key": {
                "type": "array",
                "prefixItems": [
                  {
                    "enum": [
                      "id",
                      "name",
                      "ambiguous_id",
                      "ambiguous_name"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "person_token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "inventor_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "identity_status": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "provided_id",
                    "curated_mapping",
                    "normalized_name_only",
                    "ambiguous"
                  ]
                },
                "uniqueItems": true
              },
              "caveats": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "activity": {
                "$ref": "#/$defs/exact"
              },
              "degree": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "candidate_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "source_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "strength": {
                "$ref": "#/$defs/exact"
              },
              "betweenness_unweighted": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "betweenness_weighted": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "pagerank": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "community_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "target",
              "weight",
              "unit_ids",
              "record_ids",
              "first_observation",
              "last_observation",
              "missing_date_records",
              "classifications"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "weight": {
                "$ref": "#/$defs/exact"
              },
              "unit_ids": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "record_ids": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "first_observation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/observedDate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "last_observation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/observedDate"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "missing_date_records": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "classifications": {
                "type": "array",
                "maxItems": 128,
                "items": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    },
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "uniqueItems": true
              }
            }
          }
        },
        "unplottable": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "person_key",
              "person_token",
              "inventor_id",
              "display_name",
              "identity_status",
              "caveats",
              "activity",
              "reason",
              "candidate_ids",
              "source_ids"
            ],
            "properties": {
              "person_key": {
                "type": "array",
                "prefixItems": [
                  {
                    "enum": [
                      "id",
                      "name",
                      "ambiguous_id",
                      "ambiguous_name"
                    ]
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "person_token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "inventor_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16384
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "display_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "identity_status": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "enum": [
                    "provided_id",
                    "curated_mapping",
                    "normalized_name_only",
                    "ambiguous"
                  ]
                },
                "uniqueItems": true
              },
              "caveats": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              },
              "activity": {
                "$ref": "#/$defs/exact"
              },
              "reason": {
                "const": "ambiguous_identity"
              },
              "candidate_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              },
              "source_ids": {
                "$ref": "#/$defs/identityEvidenceIds"
              }
            }
          }
        },
        "communities": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "community_id",
              "members"
            ],
            "properties": {
              "community_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16384
              },
              "members": {
                "type": "array",
                "maxItems": 200,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 16384
                },
                "uniqueItems": true
              }
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "units",
            "records",
            "ambiguous_people",
            "missing_inventor_units",
            "excluded_pair_weight",
            "excluded_person_weight"
          ],
          "properties": {
            "units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "records": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ambiguous_people": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "missing_inventor_units": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "excluded_pair_weight": {
              "$ref": "#/$defs/exact"
            },
            "excluded_person_weight": {
              "$ref": "#/$defs/exact"
            }
          }
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit",
            "person_weight",
            "pair_weight",
            "community_method",
            "metrics_scope",
            "distance",
            "precision",
            "pagerank_alpha",
            "algorithm_version",
            "pagerank_l1_tolerance",
            "pagerank_max_iterations"
          ],
          "properties": {
            "unit": {
              "anyOf": [
                {
                  "enum": [
                    "records",
                    "publication",
                    "application",
                    "family"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "person_weight": {
              "enum": [
                "full",
                "fractional"
              ]
            },
            "pair_weight": {
              "enum": [
                "joint_unit_count",
                "unit_pair_fractional"
              ]
            },
            "community_method": {
              "enum": [
                "connected_components",
                "greedy_modularity"
              ]
            },
            "metrics_scope": {
              "const": "full_graph"
            },
            "distance": {
              "const": "reciprocal_strength"
            },
            "precision": {
              "const": 12
            },
            "pagerank_alpha": {
              "const": 0.85
            },
            "algorithm_version": {
              "const": "inventor_graph.v1"
            },
            "pagerank_l1_tolerance": {
              "const": 1e-12
            },
            "pagerank_max_iterations": {
              "const": 1000
            }
          }
        },
        "pagerank_convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iterations",
            "residual"
          ],
          "properties": {
            "iterations": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "residual": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            }
          }
        }
      }
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "numerator",
        "denominator"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 3.402823669209385e+38
        },
        "numerator": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "maxLength": 40
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 40
        }
      }
    },
    "observedDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw",
        "kind",
        "precision",
        "start",
        "end"
      ],
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16384
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "enum": [
            "filing",
            "publication",
            "priority",
            "valid_from",
            "valid_to",
            "announcement",
            "effective",
            "checked",
            "citation_snapshot"
          ]
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "missing"
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "minLength": 10,
              "maxLength": 10
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "minLength": 10,
              "maxLength": 10
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
