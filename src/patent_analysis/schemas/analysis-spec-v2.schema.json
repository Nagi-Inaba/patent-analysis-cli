{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patent-analysis:analysis-spec:2.0.0",
  "title": "AnalysisSpecV2",
  "type": "object",
  "required": [
    "analysis_contract_version",
    "analysis_id",
    "resolution",
    "normalization",
    "population",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_contract_version": {"const": "2.0.0"},
    "analysis_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*\\.v[1-9][0-9]*$"},
    "resolution": {"$ref": "#/$defs/resolution"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "population": {"$ref": "#/$defs/population"},
    "parameters": {"type": "object"}
  },
  "$defs": {
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "normalization": {
      "type": "object",
      "required": ["profiles"],
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "filter": {
      "oneOf": [
        {"$ref": "#/$defs/exactFilter"},
        {"$ref": "#/$defs/oneOfFilter"},
        {"$ref": "#/$defs/yearFilter"},
        {"$ref": "#/$defs/yearRangeFilter"},
        {"$ref": "#/$defs/outsideYearRangeFilter"}
      ]
    },
    "exactFilter": {
      "type": "object",
      "required": ["role", "effect", "match", "value"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "effect": {"enum": ["include", "exclude"]},
        "match": {"const": "exact"},
        "value": {"type": "string"}
      }
    },
    "oneOfFilter": {
      "type": "object",
      "required": ["role", "effect", "match", "values"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "effect": {"enum": ["include", "exclude"]},
        "match": {"const": "one_of"},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "yearFilter": {
      "type": "object",
      "required": ["role", "effect", "match", "value"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "effect": {"enum": ["include", "exclude"]},
        "match": {"const": "year"},
        "value": {"type": "integer"}
      }
    },
    "yearRangeFilter": {
      "type": "object",
      "required": ["role", "effect", "match", "start_year", "end_year"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "effect": {"enum": ["include", "exclude"]},
        "match": {"const": "year_range"},
        "start_year": {"type": "integer"},
        "end_year": {"type": "integer"}
      }
    },
    "outsideYearRangeFilter": {
      "type": "object",
      "required": ["role", "effect", "match", "start_year", "end_year"],
      "additionalProperties": false,
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "effect": {"enum": ["include", "exclude"]},
        "match": {"const": "outside_year_range"},
        "start_year": {"type": "integer"},
        "end_year": {"type": "integer"}
      }
    },
    "selectionSet": {
      "type": "object",
      "required": ["dimension_role", "mode", "values"],
      "additionalProperties": false,
      "properties": {
        "dimension_role": {"type": "string", "minLength": 1},
        "mode": {"enum": ["include", "exclude"]},
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "source_date_role": {"type": "string", "minLength": 1},
        "start_year": {"type": "integer"},
        "end_year": {"type": "integer"}
      },
      "dependentRequired": {
        "source_date_role": ["start_year", "end_year"],
        "start_year": ["source_date_role", "end_year"],
        "end_year": ["source_date_role", "start_year"]
      }
    },
    "population": {
      "oneOf": [
        {"$ref": "#/$defs/recordPopulation"},
        {"$ref": "#/$defs/familyPopulation"},
        {"$ref": "#/$defs/earliestPopulation"}
      ]
    },
    "recordPopulation": {
      "type": "object",
      "required": ["filters", "selection_sets", "family_mode"],
      "additionalProperties": false,
      "properties": {
        "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "selection_sets": {"type": "array", "items": {"$ref": "#/$defs/selectionSet"}},
        "family_mode": {"const": "records"}
      }
    },
    "familyPopulation": {
      "type": "object",
      "required": ["filters", "selection_sets", "family_mode", "family_role", "date_role"],
      "additionalProperties": false,
      "properties": {
        "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "selection_sets": {"type": "array", "items": {"$ref": "#/$defs/selectionSet"}},
        "family_mode": {"const": "workbench-earliest.v1"},
        "family_role": {"type": "string", "minLength": 1},
        "date_role": {"type": "string", "minLength": 1}
      }
    },
    "earliestPopulation": {
      "type": "object",
      "required": [
        "filters",
        "selection_sets",
        "family_mode",
        "family_role"
      ],
      "additionalProperties": false,
      "properties": {
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "selection_sets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selectionSet"
          }
        },
        "family_mode": {
          "const": "earliest"
        },
        "family_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:.*\\S)?$"
        },
        "date_role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    }
  }
}
